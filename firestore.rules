rules_version = '2';
// 제1회 제주시농협 AI 공모전 채점 시스템 — Firestore 보안 규칙
// ※ 아래 isSuper() 의 'your-admin@gmail.com' 을 config.js 의 SUPER_ADMINS 와 같은 주소(소문자)로 바꾸세요.
//   최고 관리자가 여러 명이면 ['a@gmail.com', 'b@gmail.com'] 처럼 쉼표로 이어 씁니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function isGoogle()  { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function email()     { return request.auth.token.email.lower(); }
    function access()    { return get(/databases/$(database)/documents/config/access).data; }
    function live()      { return get(/databases/$(database)/documents/state/live).data; }
    function pub()       { return get(/databases/$(database)/documents/config/public).data; }
    function isSuper()   { return isGoogle() && email() in ['your-admin@gmail.com']; }
    function isAdmin()   { return isSuper() || (isGoogle() && email() in access().adminEmails); }
    function isJudge()   { return isGoogle() && email() in access().judgeEmails; }

    // 공개 설정(대회명·비율·심사항목) — 누구나 읽기
    match /config/public { allow read: if true;     allow write: if isAdmin(); }
    // 관리자·심사위원 명단 — 구글 로그인 사용자만 읽기
    //   운영 관리자 목록(adminEmails)은 최고 관리자만 바꿀 수 있고, 운영 관리자는 심사위원만 관리
    match /config/access {
      allow read: if isGoogle();
      allow create: if isSuper();
      allow update: if isSuper() || (isAdmin() && request.resource.data.adminEmails == resource.data.adminEmails);
      allow delete: if false;
    }
    // 로그인 기록 — 본인 기록만 남길 수 있고, 관리자만 열람
    match /logins/{key} {
      allow read: if isAdmin();
      allow create, update: if isGoogle() && key == email() && request.resource.data.email == email();
      allow delete: if isAdmin();
    }
    // 진행 상태(현재 팀, 투표 열림, 마감 팀)
    match /state/live    { allow read: if true;     allow write: if isAdmin(); }
    // 참가팀·발표 순서
    match /teams/{id}    { allow read: if true;     allow write: if isAdmin(); }
    // 추첨 이력 — 공개, 수정·삭제 불가
    match /draws/{id}    { allow read: if true;     allow create: if isAdmin(); allow update, delete: if false; }

    // 심사위원 점수 — 본인 것만 쓰기/읽기, 마감된 팀은 수정 불가, 관리자는 전체 열람
    match /scores/{sid} {
      allow read: if isAdmin() || (isJudge() && resource.data.uid == request.auth.uid);
      allow create, update: if isJudge()
        && sid == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100
        && !(request.resource.data.teamId in live().get('closedTeams', []));
      allow delete: if isAdmin();
    }

    // 관람객 투표 — 기기(익명 계정)당 팀별 1표, 현재 팀 + 투표 열림 상태에서만
    match /votes/{vid} {
      allow get: if isAdmin() || (signedIn() && vid.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$'));
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && vid == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && live().voteOpen == true
        && live().currentTeamId == request.resource.data.teamId
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= pub().get('voteScale', 10);
      allow delete: if isAdmin();
    }
  }
}
